# ============================================================
# NurseryFlower - environment variables
# .env.example ko copy karke ".env" banao (Cloudflare/Vercel me ye Environment Variables me daalo).
# KABHI service_role key ya koi secret yaha mat likho: ye sab browser me dikhte hain.
# ============================================================

# demo = poora app browser me chalta hai (koi server nahi). supabase = asli backend.
VITE_MODE=demo

# --- Supabase (VITE_MODE=supabase ke time) ---
# Supabase dashboard -> Project Settings -> API: "Project URL" aur "anon public" key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- OTP: demo | sms | email ---
# demo  = OTP hamesha 123456
# sms   = Supabase phone OTP (SMS provider chahiye, paid)
# email = Supabase email OTP (free)
VITE_OTP_PROVIDER=demo

# --- AI plant identify: mock | edge ---
# edge = aapka Supabase Edge Function URL (Gemini key sirf server me rahegi)
VITE_AI_PROVIDER=mock
VITE_AI_EDGE_URL=

# --- Payments: demo | upi ---
VITE_PAYMENT_PROVIDER=demo
VITE_UPI_ID=yourname@upi

# --- Support ---
VITE_SUPPORT_WHATSAPP=919999999999

# --- Demo ko private rakhne ke liye (weak, sirf casual logon ko rokta hai) ---
# Khali chhodo to koi gate nahi. Kuch likho to app kholne se pehle ye code poochega.
VITE_DEMO_ACCESS_CODE=
